# Copy to .env for local development: `pnpm dev` reads it automatically.

# The database from compose.yaml (`docker compose up -d`). Remove this line to run
# without a database: Theme Manager then runs stand-alone on its default Theme.
HARNESS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/harness

# Optional: the IAM suite (Identity, Authorisation). Identity's runtime role owns
# nothing and cannot bypass row-level security; create it once in the database:
#   create role harness_identity_runtime login password 'change-me' nosuperuser nobypassrls;
# HARNESS_IDENTITY_DATABASE_URL=postgres://harness_identity_runtime:change-me@localhost:5432/harness
# NUXT_IDENTITY_BASE_URL=http://localhost:3000

# Optional, with the IAM suite: Profile. Its runtime role owns nothing either:
#   create role harness_profile_runtime login password 'change-me' nosuperuser nobypassrls;
# The master key wraps each person's data key (a KMS in production). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep it: records cannot be read without it.
# HARNESS_PROFILE_DATABASE_URL=postgres://harness_profile_runtime:change-me@localhost:5432/harness
# HARNESS_PROFILE_MASTER_KEY=
# NUXT_PROFILE_BASE_URL=http://localhost:3000

# Local demonstration only: records outgoing mail so verification links can be read
# at http://localhost:3000/api/__harness/recorder, and skips the network
# compromised-password check. Never set this on a deployed application.
HARNESS_TEST_MODE=1

# Signs sessions. Replace with your own random value of at least 32 characters.
NUXT_AUTHENTICATION_SECRET=replace-me-with-a-long-random-value-of-at-least-32-characters

# Must match the address you open in the browser.
NUXT_AUTHENTICATION_BASE_URL=http://localhost:3000
