# Copy to .env for local development: `pnpm dev` reads it automatically.

# The database from compose.yaml (`docker compose up -d`). Remove this line to run
# without a database: Theme Manager then runs stand-alone on its default Theme.
HARNESS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/harness

# Local demonstration only: records outgoing mail so verification links can be read
# at http://localhost:3000/api/__harness/recorder, and skips the network
# compromised-password check. Never set this on a deployed application.
HARNESS_TEST_MODE=1

# Signs sessions. Replace with your own random value of at least 32 characters.
NUXT_AUTHENTICATION_SECRET=replace-me-with-a-long-random-value-of-at-least-32-characters

# Must match the address you open in the browser.
NUXT_AUTHENTICATION_BASE_URL=http://localhost:3000
